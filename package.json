{
  "name": "graphql-explorer-root",
  "private": true,
  "author": "Giacomo Tagliabue",
  "scripts": {
    "test": "lerna run test"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  },
  "prettier": {
    "//": "Legacy config to minimize diffs; remove in a future PR to adopt prettier defaults",
    "printWidth": 79,
    "singleQuote": true,
    "trailingComma": "all",
    "quoteProps": "consistent"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lerna": "^9.0.7",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "workspace-sources": {
    "graphql-explorer/lib/*": [
      "packages/graphql-explorer/src/*"
    ],
    "graphql-explorer-html/build/*": [
      "packages/graphql-explorer-html/src/*"
    ]
  },
  "packageManager": "yarn@4.18.0"
}
