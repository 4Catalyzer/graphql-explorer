{
  "name": "graphql-explorer",
  "version": "2.0.0-beta.1",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/4Catalyzer/graphql-explorer.git"
  },
  "author": "4Catalyzer",
  "license": "MIT",
  "scripts": {
    "xxx:remove-relative-css": "sed -i -e 's/background: url(\"..\\/img\\/loader-big.gif\") no-repeat center;//' styles/style.css",
    "build": "tsc -p tsconfig.json && yarn build:styles",
    "build:styles": "sass src:styles && yarn xxx:remove-relative-css",
    "format": "prettier --write 'src/**/*.{ts,tsx}' './*.{json,md}'",
    "lint": "yarn run -T eslint src",
    "prepublishOnly": "yarn run build",
    "tdd": "jest --watch",
    "test": "yarn lint && yarn run -T prettier --check 'src/**/*.{ts,tsx}' && yarn typecheck && yarn build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "testonly": "jest"
  },
  "files": [
    "lib",
    "styles"
  ],
  "publishConfig": {
    "access": "public"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "devDependencies": {
    "@popperjs/core": "^2.11.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "bootstrap": "^5.3.8",
    "graphql": "^16.14.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.5",
    "react": "^19.2.6",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.6",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "yup": "^1.7.1"
  },
  "dependencies": {
    "@apollo/client": "^4.2.0",
    "copy-to-clipboard": "^4.0.2",
    "lodash": "^4.18.1",
    "react-formal": "^2.7.1",
    "react-icons": "^5.6.0",
    "react-widgets": "^5.8.6",
    "sass": "^1.100.0"
  },
  "peerDependencies": {
    "bootstrap": ">=5.0.0",
    "graphql": ">=15.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-bootstrap": ">=2.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "yup": ">=1.0.0"
  }
}
