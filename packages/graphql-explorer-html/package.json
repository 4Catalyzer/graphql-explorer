{
  "name": "graphql-explorer-html",
  "version": "1.0.0-alpha.6",
  "main": "build/main.js",
  "module": "build/es/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/4Catalyzer/graphql-explorer.git"
  },
  "author": "4Catalyzer",
  "license": "MIT",
  "scripts": {
    "build": "webpack --bail --mode production",
    "format": "prettier --write 'src/**/*.{ts,tsx}' './*.{json,md}'",
    "lint": "yarn run -T eslint src",
    "prebuild": "rimraf build",
    "prepublishOnly": "yarn run build",
    "start": "DEV_SERVER=true webpack serve --mode development",
    "test": "yarn lint && yarn run -T prettier --check 'src/**/*.{ts,tsx}' && yarn typecheck",
    "typecheck": "yarn run -T tsc --noEmit -p tsconfig.build.json"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --fix",
    "*.{ts,tsx,js,mjs,json,md,css,scss}": "prettier --write"
  },
  "devDependencies": {
    "@4c/tsconfig": "^0.4.1",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "webpack": "^5.107.1",
    "webpack-atoms": "^17.1.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.4"
  },
  "dependencies": {
    "@apollo/client": "^4.2.0",
    "astroturf": "^1.2.0",
    "core-js": "^3.49.0",
    "graphql": "^16.14.0",
    "graphql-explorer": "workspace:*",
    "react": "^19.2.6",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.6",
    "react-formal": "^2.7.1",
    "yup": "^1.7.1"
  }
}
